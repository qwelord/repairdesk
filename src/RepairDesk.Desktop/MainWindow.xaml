<Window x:Class="RepairDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="RepairDesk — сервисный центр" Width="1440" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#242D31">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,31,20,34"><TextBlock Text="RepairDesk" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Мастерская под контролем" Foreground="#A7B1B4" FontSize="12" Margin="0,8,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="24,20,20,24"><TextBlock x:Name="StaffLabel" Foreground="#E5E8E9" FontWeight="SemiBold"/><TextBlock x:Name="RoleLabel" Foreground="#A7B1B4" FontSize="12" Margin="0,5,0,18"/><Button Content="Выйти" x:Name="LogoutButton" Click="Logout_Click" Background="Transparent" Foreground="#C9CFD1" BorderBrush="#566166" HorizontalAlignment="Left"/></StackPanel>
        <StackPanel x:Name="Navigation"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,24,32,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Заказы" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ThemeButton" Content="Темная тема" Click="Theme_Click" Margin="0,0,8,0"/><Button Content="Обновить" Click="Refresh_Click"/></StackPanel></Grid>
      <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Background="#F6E4DC" Padding="14" CornerRadius="4" Margin="0,0,0,16"><TextBlock x:Name="NoticeText" Foreground="#76351F"/></Border>
      <ContentControl x:Name="PageContent" Grid.Row="2"/>
      <TextBlock x:Name="StatusLabel" Grid.Row="3" Text="Локальный сервисный центр" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
    </Grid>
  </Grid>
</Window>
